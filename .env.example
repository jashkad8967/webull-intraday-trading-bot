# setup.ps1 copies this file exactly to .env.
MODE=LIVE
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
ACCOUNT_ID=
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_ENVIRONMENT=prod
WEBULL_REGION_ID=us
LIVE_TRADING_ENABLED=true

STOCK_SYMBOLS=ALL
OPTION_CONTRACTS=
OPTION_UNDERLYINGS=
OPTION_TYPE=BOTH
OPTION_MIN_DTE=7
OPTION_MAX_DTE=45
MAX_SYMBOLS=500
STOCK_UNIVERSE_RESERVE=250
STOCK_UNIVERSE_PAGE_SIZE=200
STOCK_BATCH_SIZE=100
STOCK_PRIORITY_FRACTION=0.70
STOCK_PENNY_FRACTION=0.10
PENNY_STOCK_MAX_PRICE=5.00
EXCLUDE_ETFS=true
HISTORICAL_VOLATILITY_FILTER_ENABLED=true
HISTORICAL_VOLATILITY_DAYS=20
MIN_HISTORICAL_VOLATILITY_PERCENT=3
POPULAR_STOCK_SYMBOLS=NVDA,TSLA,AMD,AAPL,AMZN,META,MSFT,GOOGL,NFLX,AVGO,COIN,PLTR,MSTR,HOOD,SOFI,RIVN,GME,AMC,NIO,BABA,F,SNAP,UBER,MARA,IONQ,RGTI,QBTS,QUBT,FCX
# Always seeded into the dashboard watchlist from the moment the bot starts,
# every run - a restart never loses them and you never have to re-add them
# from the dashboard. See README "Watchlist" for how this differs from
# POPULAR_STOCK_SYMBOLS above.
DEFAULT_WATCHLIST_SYMBOLS=AAPL,F,NVDA,MSFT,AMZN,NFLX,TSLA,NIO,ADBE,XPEV,OXY,NOW,XOM,DDOG,OPTT,FCEL,CVX,NET,FEMY,CRM,CHPT,KO,AMC,ABNB,BNKK,SNAP,DASH,SBUX,HWH,LCID,SIRI,BNGO,NVO,SPCX,SPCE,SHOP,GM,RIVN,IBM,ZM,NEGG,NVGS,ZVRA,V,MRNA,T,PYPL,PPSI,DIS,JNJ,COST,ROKU,SPYD,SPY,UBER,COIN,XYZ,WMT,DFLI,PLTR,PFE,UNH,TBB,VZ,BABA,SRPT,MARA,AVGO,GOOGL,GOOG,BB,FDX,BRK-A,GNW,OPAD,SPX,ACB,ORCL,IXIC,META,QQQ,RBLX,UPS,QCOM,AAL,CCX,SKYA,CRWD,CTRM,NKE,OCGN,SNDA,WWR,INTC,HD,NIU,GME,DIA,ATOS,BAD,DKNG,UAL,MOBX,HOOD,DAL,CLOV,RKLB,TSM,MU,JPM,AMD,NOK,BA,RIOT,TLRY,SOFI,CENN
POPULAR_STOCK_MIN_VOLUME=1000000
POPULAR_STOCK_MAX_SPREAD_PERCENT=0.50
STOCK_POPULAR_CAPITAL_FRACTION=0.70
STOCK_PENNY_CAPITAL_FRACTION=0.10
STOCK_DISCOVERY_CAPITAL_FRACTION=0.20
# Merges today's top price-gainers (Webull's DAY_1/CHANGE_RATIO screener) into
# the ALL universe, so actual current uptrend/momentum names are included
# alongside the most-active-by-volume list. Set to 0 to disable.
TOP_GAINERS_LIMIT=200

# Market-cap-tiered universe: when enabled, STOCK_SYMBOLS=ALL loads a large,
# volatility-filtered universe ranked by market cap from Webull's screener
# instead of the popular/penny/discovery buckets above, and allocates capital
# by cap-size tier. To get 500+ stocks paged in chunks of 500, raise
# MAX_SYMBOLS (e.g. 750-1000) and set STOCK_UNIVERSE_PAGE_SIZE=500.
MARKET_CAP_ALLOCATION_ENABLED=false
STOCK_LARGE_CAP_MIN_MARKET_VALUE=100000000000
STOCK_LARGE_CAP_CAPITAL_FRACTION=0.80
STOCK_SMALL_CAP_CAPITAL_FRACTION=0.20

# Micro-scalp mode: fixed-cents mean-reversion on a small list of always-
# ticking, ultra-liquid symbols (buy a small dip below the recent average,
# take a small fixed profit on the bounce back). Fully separate from the
# buckets above - its own capital slice and position cap, and these symbols
# are excluded from the normal EMA-based universe scan so the two decision
# paths never fight over the same position. See README "Micro-scalp mode".
MICRO_SCALP_ENABLED=false
MICRO_SCALP_SYMBOLS=TSLA,NVDA,AMD,COIN,PLTR,MSTR
MICRO_SCALP_CAPITAL_FRACTION=0.20
MICRO_SCALP_MAX_POSITIONS=5
MICRO_SCALP_DIP_CENTS=0.05
MICRO_SCALP_TARGET_CENTS=0.06
MICRO_SCALP_STOP_CENTS=0.10
MICRO_SCALP_REFERENCE_WINDOW=20

# Fractional shares: when a bucket/symbol's available budget can't afford
# even one whole share, place a MARKET order for a fraction of a share
# instead of skipping the entry. Webull only supports fractional trading as
# a MARKET order during core hours (never LIMIT, never extended hours), and
# requires the order value to clear FRACTIONAL_SHARES_MIN_NOTIONAL. See
# README "Fractional shares".
FRACTIONAL_SHARES_ENABLED=false
FRACTIONAL_SHARES_MIN_NOTIONAL=5
OPTION_BATCH_SIZE=20
OPTION_DISCOVERY_PER_CYCLE=1
OPTION_DISCOVERY_SECONDS=15

STOCK_QUANTITY=1
OPTION_QUANTITY=1
# The shared cap on concurrent open positions across stocks, options, and
# micro-scalp combined. Raised from the old default of 5-10: with each
# entry sized as a fraction of *remaining* buying power (see
# STOCK_CORE_SESSION_POSITION_FRACTION below), a low position cap leaves a
# meaningful chunk of capital sitting idle even when every slot is filled -
# see README "Capital deployment".
MAX_OPEN_POSITIONS=20
MAX_ORDER_NOTIONAL=1000

# During core trading hours (9:30-4:00), new stock entries are sized as
# this fraction of total account buying power and placed as a fractional
# MARKET order, instead of the fixed STOCK_QUANTITY whole-share sizing -
# see README "Fractional shares". Outside core hours, entries still use
# fixed STOCK_QUANTITY sizing since Webull doesn't allow fractional orders
# in extended hours. Set to 0 to disable and use fixed-quantity sizing all
# day, matching pre-existing behavior.
STOCK_CORE_SESSION_POSITION_FRACTION=0.15

POLL_SECONDS=0.25
ACCOUNT_REFRESH_SECONDS=5
TRADE_COOLDOWN_SECONDS=15
STOCK_MAX_TRADES_PER_HOUR=12
EMA_FAST_PERIOD=3
EMA_SLOW_PERIOD=8
REENTER_ON_TREND=true
REENTER_CONFIRMATION_POLLS=2
VWAP_ENTRY_BAND_PERCENT=0.001
# Rewards symbols that keep flipping direction (a repeating, choppy pattern)
# over ones that only moved once today - see README "Trade cadence" section.
STOCK_OSCILLATION_WEIGHT=0.5
STOCK_MIN_NET_PROFIT_PERCENT=0.0015
STOCK_ESTIMATED_ROUND_TRIP_COST_PERCENT=0.002
# Both bounds are set with real margin above STOCK_ENTRY_MAX_SPREAD_PERCENT
# below (0.50%) - the *floor*, not just the ceiling, needs to clear it: a
# calm stock's stop clamps to this floor regardless of the multiplier, and
# if the floor sat below the max tolerated spread (it briefly did: 0.12%
# floor vs a 0.50% spread gate), an entry near that spread ceiling could
# get stopped out by an ordinary bid/ask bounce alone, before any real
# adverse move - stops firing on noise, not on an actual loss developing.
# Raised from 0.006/0.01 - stops were still cutting positions on ordinary
# intraday noise before a real adverse move had a chance to develop (one
# closed for a 7-cent loss). Widening both bounds gives a position more
# room to breathe before the stop fires.
STOCK_STOP_LOSS_MIN_PERCENT=0.009
STOCK_STOP_LOSS_MAX_PERCENT=0.015
STOCK_STOP_LOSS_RANGE_MULTIPLIER=0.35
# Target = stop distance * this multiple. At 1.2, breakeven needs a ~45.5%
# win rate (1 / (1 + 1.2)) - too thin a margin for normal noise/whipsaw, and
# a real cause of net-losing days even with a healthy number of winners. At
# 1.8, breakeven only needs ~35.7% - a much more comfortable cushion. Costs
# more per winning trade (needs a bigger move to actually reach target), so
# fewer winners will hit it before reversing - a real tradeoff, not a free
# win, same as every other gate in this file.
STOCK_TARGET_STOP_MULTIPLE=1.8
# 0.15% was blocking the large majority of scan candidates before they ever
# reached the VWAP/extension/EMA checks - see README "Entry gates". This is
# a real tradeoff, not a free win - see the stop-loss bounds above, which
# are sized to keep real margin above whatever this is set to.
STOCK_ENTRY_MAX_SPREAD_PERCENT=0.50
STOCK_ENTRY_MAX_EXTENSION_PERCENT=0.01
# The first few minutes after the 9:30 bell have naturally wider spreads and
# an under-formed intraday high, so the gates above reject almost everything
# right at the open. This window relaxes both gates near the bell only, then
# snaps back to the full-day thresholds above. Set OPENING_GRACE_MINUTES=0 to
# disable.
OPENING_GRACE_MINUTES=10
OPENING_GRACE_SPREAD_MULTIPLIER=2
OPENING_GRACE_EXTENSION_MULTIPLIER=2
OPTION_TAKE_PROFIT_PRICE=0.01
OPTION_STOP_LOSS_PERCENT=0.50

MARKET_REQUESTS_PER_MINUTE=240
OPTION_INSTRUMENT_REQUESTS_PER_MINUTE=45
STOCK_INSTRUMENT_REQUESTS_PER_30_SECONDS=9
ACCOUNT_REQUESTS_PER_SECOND=0.8
ORDER_REQUESTS_PER_MINUTE=480
ORDER_TIMEOUT_SECONDS=120
ORDER_MONITOR_SECONDS=5
STOP_LOSS_ESCALATE_SECONDS=15
STALL_BREAKER_ENABLED=true
STALL_BREAKER_SECONDS=120
STALL_BREAKER_MIN_PROFIT=0.01
DAILY_LOSS_CIRCUIT_BREAKER_ENABLED=false
DAILY_MAX_LOSS_DOLLARS=50

AGENT_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
AGENT_CORE_RESEARCH_SECONDS=120
AGENT_EXTENDED_RESEARCH_SECONDS=622
# Groq's real limit is tokens per day (TPD), not request count - a 429
# ("rate_limit_exceeded") can hit well under AGENT_DAILY_REQUEST_LIMIT
# requests. This must match your actual Groq model/tier TPD limit (see
# console.groq.com/settings/billing) with some margin - default assumes the
# free/on-demand llama-3.3-70b-versatile tier (100000 TPD). The bot tracks
# its own rolling 24h usage from each response and stops submitting before
# hitting Groq's real ceiling; if it still 429s (e.g. an agentic model's
# server-side web search consumes tokens we can't see ahead of time), it
# backs off for the duration Groq's own error reports instead of retrying
# into the same limit every cycle.
AGENT_DAILY_TOKEN_BUDGET=90000
AGENT_DAILY_REQUEST_LIMIT=250
AGENT_MAX_SYMBOLS=5
AGENT_DISCOVERY_MAX_SYMBOLS=10
AGENT_TIMEOUT_SECONDS=60
AGENT_EXIT_INFLUENCE_ENABLED=true
AGENT_EXIT_MIN_CONFIDENCE=0.60
AGENT_RUNNER_BIAS_THRESHOLD=0.50
AGENT_RUNNER_PROFIT_PERCENT=0.01
AGENT_DERISK_BIAS_THRESHOLD=-0.50
LOSS_CIRCUIT_BREAKER_ENABLED=false
LOSS_SPREE_POSITION_COUNT=3
LOSS_SPREE_TOTAL_DOLLARS=1.00
LOSS_REEVALUATION_SECONDS=120

TRADING_TIMEZONE=America/New_York
MARKET_OPEN_TIME=04:00
EOD_CLOSE_TIME=19:50
MARKET_CLOSE_TIME=20:00
OPTION_MARKET_OPEN_TIME=09:30
OPTION_EOD_CLOSE_TIME=15:50
OPTION_MARKET_CLOSE_TIME=16:00
EOD_RETRY_SECONDS=10
MARKET_HOLIDAYS=
WASH_SALE_BLOCK_DAYS=31
WASH_SALE_STATE_FILE=conf/wash_sale_blocks.json
DAILY_PNL_STATE_FILE=conf/daily_pnl.json
TRADE_HISTORY_STATE_FILE=conf/trade_history.json
INVALID_SYMBOL_STATE_FILE=conf/invalid_symbols.json
STOCK_LIMIT_OFFSET=0.005
OPTION_LIMIT_OFFSET=0.03
LOG_DIRECTORY=logs
STATUS_FILE=status.json
